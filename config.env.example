# SmartVision Configuration Template
# Copy this file to config.env and replace the placeholder values.

# Cloudinary Settings
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Settings
FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com/
FIREBASE_KEY_PATH=firebase/firebase_key.json

# Feature Flags
DISABLE_CLOUDINARY_UPLOAD=0
ENABLE_LOCAL_STORAGE=1

# Alert Settings
ALERT_COOLDOWN=10
MAX_LOCAL_ALERTS=500
CLEANUP_INTERVAL=3600

# Camera Settings
CAMERA_INDEX=0

# Model Settings
MODEL_NAME=Facenet512
DETECTOR_BACKEND=opencv
FACE_THRESHOLD=0.45
FRAME_SKIP=5

# Detection Settings
LOITERING_TIME=25
RUN_CENTER_SPEED=8
MAX_HISTORY=30

# Logging
LOG_LEVEL=INFO
LOGS_DIR=logs

# Flask Settings
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=change_this_to_a_random_secret_key

# Server Settings
HOST=0.0.0.0
PORT=5000